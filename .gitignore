# ==============================================================================
# RainAI Consolidated Root Workspace .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Rust Ecosystem & Build Artifacts
# ------------------------------------------------------------------------------
/target/
**/*.rs.bk
Cargo.lock.log
*.log

# ------------------------------------------------------------------------------
# 2. Python Ecosystem, Cache & Testing
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 3. Model Weights & Training Checkpoints (never committed; PLAN.md D2)
# ------------------------------------------------------------------------------
# Weights ship as GitHub release assets, not in git. Manifests and session JSON
# under crates/inference/data stay tracked.
ai/checkpoints/
checkpoints/
crates/inference/data/wasm/*
!crates/inference/data/wasm/.gitkeep
crates/inference/data/**/*.bin
crates/inference/data/**/*.safetensors
crates/inference/data/**/*.onnx
crates/inference/data/**/*.onnx.data
crates/inference/data/**/*.pt

# ------------------------------------------------------------------------------
# 4. Data (never committed; PLAN.md D2)
# ------------------------------------------------------------------------------
# rainai_ingest downloads into data/ from source_registry.json and generates the
# ledger, ATTRIBUTIONS.txt, manifest_provenance.json and data/sources.json there.
/data/
/Data/
crates/*/data/rain/

# Audio and model files anywhere
*.flac
*.wav
*.ogg
*.mp3
*.safetensors
*.onnx
*.onnx.data
*.bin
*.pt
attributions.bin
ATTRIBUTIONS.txt
manifest_provenance.json
data_utility_ledger.json
ledger.jsonl

# ------------------------------------------------------------------------------
# 5. Frontend UI, Web & Edge Cloud Deployments
# ------------------------------------------------------------------------------
/dist/
/crates/web/dist/
.stage/
.wrangler/

# ------------------------------------------------------------------------------
# 6. Logging, Tracking & Telemetry
# ------------------------------------------------------------------------------
logs/*

# ------------------------------------------------------------------------------
# 7. Operating System & System Cache
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 8. Local IDE & Project Editor Configurations
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
