# ==============================================================================
# RainAI Consolidated Root Workspace .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Rust Ecosystem & Build Artifacts
# ------------------------------------------------------------------------------
/target/
**/*.rs.bk
Cargo.lock.log
*.log

# ------------------------------------------------------------------------------
# 2. Python Ecosystem, Cache & Testing
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 3. Model Weights & Training Checkpoints
# ------------------------------------------------------------------------------
# Ignore ephemeral scratch builds
ai/checkpoints/
crates/inference/data/wasm/*
!crates/inference/data/wasm/.gitkeep

# Track canonical Candle checkpoints, sessions, and Safetensors weights
# (Binary weights are tracked via Git LFS as specified in .gitattributes)
!crates/inference/data/candle/
!crates/inference/data/candle/**
!checkpoints/**
!**/training_session.json

# ------------------------------------------------------------------------------
# 4. Data Directories, Audio Datasets & Score Ledgers
# ------------------------------------------------------------------------------
# Ignore transient rolling cache audio chunks (up to 15 GB local ceiling)
/data/processed/*.wav
/Data/processed/*.wav

# Global exclusions for audio and binary model artifacts outside canonical datasets
*.flac
*.wav
*.ogg
*.mp3
*.safetensors
*.onnx
*.onnx.data
*.bin
*.pt

# Allow canonical audio training datasets in git (handled via Git LFS in .gitattributes)
!/data/rain/**
!/Data/rain/**
!/data/rain/**/*.wav
!/data/rain/**/*.mp3
!/data/rain/**/*.flac
!/data/rain/**/*.ogg
!/data/rain/*.wav
!/data/rain/*.mp3
!/data/rain/*.flac
!/data/rain/*.ogg
!/Data/rain/**/*.wav
!/Data/rain/**/*.mp3
!/Data/rain/**/*.flac
!/Data/rain/**/*.ogg
!/Data/rain/*.wav
!/Data/rain/*.mp3
!/Data/rain/*.flac
!/Data/rain/*.ogg

# Allow data quality score ledgers, manifests, provenance, and attribution dictionaries in git
!**/data_utility_ledger.json
!**/manifest.json
!**/manifest_provenance.json
!**/sources.json
!**/ATTRIBUTIONS.txt
!**/attributions.bin
!crates/inference/data/candle/*.safetensors
!checkpoints/*.safetensors

# ------------------------------------------------------------------------------
# 5. Frontend UI, Web & Edge Cloud Deployments
# ------------------------------------------------------------------------------
/dist/
/crates/web/dist/
.stage/
.wrangler/

# ------------------------------------------------------------------------------
# 6. Logging, Tracking & Telemetry
# ------------------------------------------------------------------------------
logs/*

# ------------------------------------------------------------------------------
# 7. Operating System & System Cache
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 8. Local IDE & Project Editor Configurations
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
